<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Le Gouvernement</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
body { background: #0d0d0d; min-height: 100vh; padding: 2rem 1rem; }
.header { text-align: center; margin-bottom: 2.5rem; }
.header-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; border: 0.5px solid #333; border-radius: 99px; padding: 4px 14px; margin-bottom: 14px; }
.online-dot { width: 6px; height: 6px; border-radius: 50%; background: #1D9E75; }
.title { font-size: 32px; font-weight: 500; color: #f0f0f0; letter-spacing: -0.5px; }
.title span { color: #7F77DD; }
.subtitle { font-size: 13px; color: #555; margin-top: 6px; }
.sync-status { font-size: 11px; margin-top: 8px; color: #444; display: flex; align-items: center; justify-content: center; gap: 6px; }
.sync-dot { width: 5px; height: 5px; border-radius: 50%; background: #444; transition: background 0.3s; }
.sync-dot.ok { background: #1D9E75; }
.sync-dot.err { background: #E24B4A; }
.sync-dot.loading { background: #BA7517; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; max-width: 700px; margin: 0 auto; }
.card { background: #161616; border: 0.5px solid #2a2a2a; border-radius: 16px; padding: 1.5rem 1.25rem; display: flex; flex-direction: column; align-items: center; gap: 11px; transition: border-color 0.2s; }
.card:hover { border-color: #444; }
.card.dead { opacity: 0.4; filter: grayscale(1); }
.avatar { width: 70px; height: 70px; border-radius: 50%; border: 2px solid; overflow: hidden; }
.avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.av-benji { border-color: #534AB7; box-shadow: 0 0 0 4px #534AB722; }
.av-sofiane { border-color: #0F6E56; box-shadow: 0 0 0 4px #0F6E5622; }
.av-yanis { border-color: #A32D2D; box-shadow: 0 0 0 4px #A32D2D22; }
.av-init { display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 500; background: #1e2e28; color: #5DCAA5; }
.name { font-size: 18px; font-weight: 500; color: #f0f0f0; }
.badge { font-size: 10px; padding: 3px 10px; border-radius: 99px; letter-spacing: 0.5px; }
.b-benji { background: #1e1c35; color: #AFA9EC; border: 0.5px solid #3C3489; }
.b-sofiane { background: #0e2420; color: #5DCAA5; border: 0.5px solid #0F6E56; }
.b-yanis { background: #2a1414; color: #F09595; border: 0.5px solid #A32D2D; }
.desc { font-size: 11px; color: #555; text-align: center; line-height: 1.6; }
.section { width: 100%; }
.row { display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 3px; }
.lbl { color: #555; }
.bar-bg { width: 100%; height: 6px; background: #222; border-radius: 99px; overflow: hidden; margin-bottom: 8px; }
.bar { height: 100%; border-radius: 99px; transition: width 0.4s cubic-bezier(.4,0,.2,1); }
.bar-hp-benji { background: #7F77DD; }
.bar-hp-sofiane { background: #1D9E75; }
.bar-hp-yanis { background: #E24B4A; }
.bar-item-benji { background: #3C3489; }
.bar-item-sofiane { background: #085041; }
.bar-item-yanis { background: #791F1F; }
.val-benji { color: #AFA9EC; font-weight: 500; }
.val-sofiane { color: #5DCAA5; font-weight: 500; }
.val-yanis { color: #F09595; font-weight: 500; }
.btn { width: 100%; padding: 9px 0; border: 0.5px solid; border-radius: 8px; font-size: 12px; cursor: pointer; background: transparent; transition: background 0.13s, transform 0.1s; }
.btn:active { transform: scale(0.97); }
.btn:disabled { opacity: 0.25; cursor: not-allowed; }
.btn-benji { border-color: #3C3489; color: #AFA9EC; }
.btn-benji:hover:not(:disabled) { background: #1e1c35; }
.btn-sofiane { border-color: #085041; color: #5DCAA5; }
.btn-sofiane:hover:not(:disabled) { background: #0e2420; }
.btn-yanis { border-color: #791F1F; color: #F09595; }
.btn-yanis:hover:not(:disabled) { background: #2a1414; }
.ko { font-size: 11px; color: #E24B4A; font-weight: 500; letter-spacing: 0.5px; }
.bottom { max-width: 700px; margin: 1.5rem auto 0; display: flex; flex-direction: column; gap: 12px; }
.action-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.btn-undo { display: flex; align-items: center; gap: 7px; padding: 8px 18px; border: 0.5px solid #333; border-radius: 8px; background: #161616; color: #888; font-size: 12px; cursor: pointer; transition: background 0.13s, color 0.13s; }
.btn-undo:hover:not(:disabled) { background: #222; color: #ccc; border-color: #555; }
.btn-undo:active { transform: scale(0.97); }
.btn-undo:disabled { opacity: 0.3; cursor: not-allowed; }
.btn-reset { display: flex; align-items: center; gap: 7px; padding: 8px 18px; border: 0.5px solid #2a1414; border-radius: 8px; background: #161616; color: #E24B4A; font-size: 12px; cursor: pointer; transition: background 0.13s; }
.btn-reset:hover { background: #2a1414; }
.log { background: #111; border-radius: 12px; border: 0.5px solid #222; padding: 1rem 1.25rem; }
.log-lbl { font-size: 11px; color: #444; margin-bottom: 8px; letter-spacing: 1px; text-transform: uppercase; }
.log-e { font-size: 11px; color: #666; padding: 5px 0; border-bottom: 0.5px solid #1e1e1e; line-height: 1.6; display: flex; align-items: flex-start; gap: 8px; }
.log-e:last-child { border-bottom: none; }
.dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
.dot-benji { background: #7F77DD; }
.dot-sofiane { background: #1D9E75; }
.dot-yanis { background: #E24B4A; }
.log-empty { font-size: 11px; color: #333; padding: 4px 0; }
</style>
</head>
<body>

<div class="header">
  <div class="header-badge"><span class="online-dot"></span> En ligne · Multijoueur</div>
  <h1 class="title">Le <span>Gouvernement</span></h1>
  <p class="subtitle">Unité d'élite — pouvoirs spéciaux actifs</p>
  <div class="sync-status">
    <span class="sync-dot" id="sync-dot"></span>
    <span id="sync-label">Connexion...</span>
  </div>
</div>

<div class="grid" id="cards"></div>

<div class="bottom">
  <div class="action-row">
    <button class="btn-undo" id="btn-undo" onclick="undoLast()" disabled>
      <i class="ti ti-arrow-back-up" style="font-size:15px" aria-hidden="true"></i> Annuler la dernière action
    </button>
    <button class="btn-reset" onclick="resetAll()">
      <i class="ti ti-refresh" style="font-size:15px" aria-hidden="true"></i> Reset
    </button>
  </div>
  <div class="log">
    <p class="log-lbl"><i class="ti ti-terminal-2" style="font-size:13px;vertical-align:-2px" aria-hidden="true"></i> Journal</p>
    <div id="log-list"><p class="log-empty">Chargement...</p></div>
  </div>
</div>

<script>
const YANIS_IMG = "data:image/png;base64,";
const BENJI_IMG = "data:image/png;base64,";

const API = "/api/state";
const DEFAULT = { benji:{hp:100,item:100}, sofiane:{hp:100,item:100}, yanis:{hp:100,item:100} };
const PERSOS = [
  { id:'benji', name:'Benji', avCls:'av-benji', badgeCls:'b-benji', valCls:'val-benji', barHp:'bar-hp-benji', barItem:'bar-item-benji', btnCls:'btn-benji', dotCls:'dot-benji', power:'Teleportation', itemName:'Cape', itemDesc:"Cape magique — se degrade a chaque saut", img:BENJI_IMG },
  { id:'sofiane', name:'Sofiane', avCls:'av-sofiane av-init', badgeCls:'b-sofiane', valCls:'val-sofiane', barHp:'bar-hp-sofiane', barItem:'bar-item-sofiane', btnCls:'btn-sofiane', dotCls:'dot-sofiane', power:'Resurrection', itemName:'Collier', itemDesc:"Collier sacre — s'use a chaque resurrection", img:null },
  { id:'yanis', name:'Yanis', avCls:'av-yanis', badgeCls:'b-yanis', valCls:'val-yanis', barHp:'bar-hp-yanis', barItem:'bar-item-yanis', btnCls:'btn-yanis', dotCls:'dot-yanis', power:'Elimination', itemName:'Lunettes', itemDesc:"Lunettes Death Note — s'usent a chaque cible", img:YANIS_IMG }
];

let state = JSON.parse(JSON.stringify(DEFAULT));
let log = [];
let history = [];
let busy = false;

function setSyncStatus(s, msg) {
  const dot = document.getElementById('sync-dot');
  const lbl = document.getElementById('sync-label');
  dot.className = 'sync-dot ' + s;
  lbl.textContent = msg;
}

async function fetchState() {
  try {
    const r = await fetch(API);
    if (!r.ok) throw new Error();
    const data = await r.json();
    state = data.state || JSON.parse(JSON.stringify(DEFAULT));
    log = data.log || [];
    history = data.history || [];
    setSyncStatus('ok', 'Synchronisé — mise à jour toutes les 3s');
    renderAll();
  } catch(e) {
    setSyncStatus('err', 'Erreur de connexion');
  }
}

async function pushState() {
  try {
    setSyncStatus('loading', 'Sauvegarde...');
    const r = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ state, log, history })
    });
    if (!r.ok) throw new Error();
    setSyncStatus('ok', 'Synchronisé — mise à jour toutes les 3s');
  } catch(e) {
    setSyncStatus('err', 'Erreur de sauvegarde');
  }
}

async function useAction(pid, hpCost, itemCost) {
  if (busy) return;
  const p = PERSOS.find(x => x.id === pid);
  const s = state[pid];
  if (s.hp <= 0) return;
  busy = true;
  const snap = JSON.parse(JSON.stringify(state));
  const pHp = s.hp, pItem = s.item;
  s.hp = Math.max(0, s.hp - hpCost);
  s.item = Math.max(0, s.item - itemCost);
  const itemBroke = pItem > 0 && s.item === 0;
  const ts = new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  const msg = p.name+' utilise '+p.power+' | HP: '+pHp+'%→'+s.hp+'% | '+p.itemName+': '+pItem+'%→'+s.item+'%'+(s.hp===0?' 💀 KO!':'')+(itemBroke?' — '+p.itemName+' detruite!':'');
  log.unshift({ msg, dotCls:p.dotCls, ts });
  history.unshift({ snap, msg, dotCls:p.dotCls, ts });
  renderAll();
  await pushState();
  busy = false;
}

async function undoLast() {
  if (busy || history.length === 0) return;
  busy = true;
  const last = history.shift();
  state = last.snap;
  log.shift();
  renderAll();
  await pushState();
  busy = false;
}

async function resetAll() {
  if (!confirm('Remettre tous les HP et items à 100% pour tout le monde ?')) return;
  busy = true;
  state = JSON.parse(JSON.stringify(DEFAULT));
  log = [];
  history = [];
  renderAll();
  await pushState();
  busy = false;
}

function renderAll() {
  PERSOS.forEach(p => renderCard(p));
  renderLog();
  document.getElementById('btn-undo').disabled = history.length === 0 || busy;
}

function renderCard(p) {
  const s = state[p.id];
  const card = document.getElementById('card-' + p.id);
  if (!card) return;
  card.className = 'card' + (s.hp <= 0 ? ' dead' : '');
  card.querySelector('.hp-val').textContent = s.hp + '%';
  card.querySelector('.item-val').textContent = s.item + '%';
  card.querySelector('.bar-hp').style.width = s.hp + '%';
  card.querySelector('.bar-item').style.width = s.item + '%';
  card.querySelectorAll('.btn').forEach(btn => { btn.disabled = s.hp <= 0 || busy; });
  card.querySelector('.ko').style.display = s.hp <= 0 ? 'block' : 'none';
}

function renderLog() {
  const el = document.getElementById('log-list');
  if (!el) return;
  if (!log.length) { el.innerHTML = '<p class="log-empty">Aucune action...</p>'; return; }
  el.innerHTML = log.slice(0,8).map(e =>
    '<div class="log-e"><span class="dot '+e.dotCls+'"></span><span style="color:#444;margin-right:5px">['+e.ts+']</span><span>'+e.msg+'</span></div>'
  ).join('');
}

function buildCards() {
  const grid = document.getElementById('cards');
  grid.innerHTML = '';
  PERSOS.forEach(p => {
    const d = document.createElement('div');
    d.className = 'card'; d.id = 'card-' + p.id;
    const av = p.img
      ? '<div class="avatar '+p.avCls+'"><img src="'+p.img+'" alt="'+p.name+'"></div>'
      : '<div class="avatar '+p.avCls+'">'+p.name[0]+'</div>';
    d.innerHTML = av +
      '<p class="name">'+p.name+'</p>'+
      '<span class="badge '+p.badgeCls+'">'+p.power+'</span>'+
      '<p class="desc">'+p.itemDesc+'</p>'+
      '<div class="section">'+
        '<div class="row"><span class="lbl">HP</span><span class="hp-val '+p.valCls+'">100%</span></div>'+
        '<div class="bar-bg"><div class="bar bar-hp '+p.barHp+'" style="width:100%"></div></div>'+
        '<div class="row"><span class="lbl">'+p.itemName+'</span><span class="item-val '+p.valCls+'">100%</span></div>'+
        '<div class="bar-bg"><div class="bar bar-item '+p.barItem+'" style="width:100%"></div></div>'+
      '</div>'+
      '<div class="ko" style="display:none">KO</div>'+
      '<div class="btns"><button class="btn '+p.btnCls+'" onclick="useAction(\''+p.id+'\',10,10)">Utiliser le pouvoir</button></div>';
    grid.appendChild(d);
  });
}

buildCards();
fetchState();
setInterval(fetchState, 3000);
</script>
</body>
</html>
